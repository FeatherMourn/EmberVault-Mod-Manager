{
  "id": "embervault.mod-manager",
  "name": "Mod Manager",
  "version": "0.1.0",
  "publisher": "EmberVault",
  "minimum_core_version": "1.0.0",
  "capabilities": ["mods.inspect", "mods.search", "mods.compatibility-review"],
  "feature_state": "experimental",
  "process_mode": "embedded",
  "entrypoint": "src/module.py",
  "application_entrypoint": "ui/Main.qml",
  "launcher": "src/launcher.py",
  "contract_version": 1,
  "safety": {"read_only": true, "requires_backup": false, "allowed_profiles": ["default", "research"]},
  "recovery": {"rollback": "Deferred: no package mutation is available in the read-only module.", "verification": "Review supplied backup and recovery evidence from Save Manager."},
  "operation_types": ["mod-inspection", "mod-search", "mod-compatibility-review"]
}
